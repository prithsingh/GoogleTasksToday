{
  "manifest_version": 3,
  "name": "Today View for Google Tasks",
  "version": "1.0.0",
  "description": "Adds a Today view to the Google Tasks sidebar showing overdue and due-today tasks from all your lists.",
  "content_scripts": [
    {
      "matches": ["https://tasks.google.com/*", "https://calendar.google.com/calendar/*"],
      "all_frames": true,
      "css": ["content.css"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
